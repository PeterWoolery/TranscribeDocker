FROM python:3.12-slim-trixie AS whisper-build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates cmake git libvulkan-dev spirv-headers glslc \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch b4938 https://github.com/ggml-org/whisper.cpp.git /src \
    && test "$(git -C /src rev-parse HEAD)" = "371b5a7561823ab2bb32142d2751e35e7534727b" \
    && cmake -S /src -B /build \
        -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
        -DGGML_VULKAN=ON -DGGML_NATIVE=OFF \
        -DWHISPER_BUILD_TESTS=OFF -DWHISPER_BUILD_SERVER=OFF \
    && cmake --build /build --target whisper-cli --parallel 2

FROM python:3.12-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/radeon_icd.json

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg curl libgomp1 libvulkan1 mesa-vulkan-drivers vulkan-tools \
    && rm -rf /var/lib/apt/lists/*

COPY --from=whisper-build /build/bin/whisper-cli /usr/local/bin/whisper-cli

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
COPY entrypoint.sh /usr/local/bin/transcribedocker-entrypoint

ENTRYPOINT ["/bin/sh", "/usr/local/bin/transcribedocker-entrypoint"]

CMD ["celery", "-A", "app.workers.celery_app:celery_app", "worker", "-l", "INFO", "--concurrency=1"]
